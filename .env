# Movie Rating Sentinel — Environment Variables
# Copy this file to .env and fill in your values

# RSS feed to scan for movies
RSS_FEED_URL=https://yoursite.com/movies/rss

# OMDb API key — free at https://www.omdbapi.com/apikey.aspx
OMDB_API_KEY=your_omdb_key_here

# SendGrid API key — free tier at https://sendgrid.com
SENDGRID_API_KEY=your_sendgrid_key_here

# Email addresses
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=you@example.com

# Rating thresholds (optional — defaults shown)
IMDB_THRESHOLD=8.0
RT_THRESHOLD=80

# Max movies to check per run (optional)
MAX_MOVIES=30
