# Movie Rating Sentinel — Environment Variables
# Copy this file to .env and fill in your values

# Your DrunkenSlug RSS feed URL
RSS_FEED_URL=https://drunkenslug.com/rss?t=2000&dl=1&i=YOUR_ID&r=YOUR_KEY

# SendGrid API key — free tier at https://sendgrid.com
SENDGRID_API_KEY=SG.your_sendgrid_key_here

# Email addresses
EMAIL_FROM=noreply@yourdomain.com
EMAIL_TO=you@example.com

# IMDb rating threshold (optional — default is 8.0)
IMDB_THRESHOLD=8.0
